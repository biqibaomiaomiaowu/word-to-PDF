# Backend Configuration
PROJECT_NAME="Word to PDF Converter"
API_V1_STR="/api"

# File Directories (Relative to backend startup path or absolute)
UPLOAD_DIR="temp_uploads"
OUTPUT_DIR="output_pdfs"

# Limits & Behavior
MAX_FILE_SIZE_MB=50
CONVERSION_TIMEOUT_SECONDS=120
MAX_CONCURRENT_TASKS=2

# Cleanup Settings
ENABLE_AUTO_CLEANUP=True
# Retention time for completed/failed task files (default 3600 seconds = 1 hour)
FILE_RETENTION_SECONDS=3600

# Frontend Configuration
# Un-comment below when building for production if API is hosted elsewhere.
# Defaults to relative path `/api` which is proxied locally or by Nginx.
# VITE_API_URL=http://your-server-domain/api
